{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
	"runtime.version": "LuaJIT",
    "workspace.library": [ "./pico8defs/" ],
    "hint.enable": true,
    "format.enable": true,
	"diagnostics.disable": [
		"lowercase-global",
		"err-esc"
	],
	"runtime.nonstandardSymbol": [
		"!=",
		"+=",
		"-=",
		"*=",
		"/=",
		"%=",
		"^=",
		"|=",
		"&=",
		"<<=",
		">>=",
		"//"
	],
	"runtime.builtin": {
		"basic": "disable",
		"bit": "disable",
		"bit32": "disable",
		"builtin": "disable",
		"coroutine": "disable",
		"debug": "disable",
		"ffi": "disable",
		"io": "disable",
		"jit": "disable",
		"math": "disable",
		"os": "disable",
		"package": "disable",
		"string": "disable",
		"table": "disable",
		"table.clear": "disable",
		"table.new": "disable",
		"utf8": "disable"
	}
}
